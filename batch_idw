"""
Batch IDW interpolation with percentile-based classified symbology.
Classes: min -> 5th -> 25th -> 50th -> 75th -> 90th -> 95th -> max (7 classes).
Color ramp: RdYlBu-7 (red at high values). Break values are exact/unrounded;
only the displayed labels are rounded (normal rounding) to integers.
Classification method + color ramp are set via arcpy.mp (so the Symbology
pane UI shows "Manual Interval" and "Red-Yellow-Blue (7 Classes)"), the CIM layer is
mutated afterward so the actual break values/labels are exact.

KEY FIXES:
  1. arcpy.mp uses 'ManualInterval', CIM uses 'Manual' - these are different!
  2. Labels must be set via arcpy.mp BEFORE final layer.symbology assignment,
     otherwise Pro regenerates them from float values (showing decimals).
  3. numberFormat removed to prevent interference with explicit labels.
  4. sym.colorizer.classBreaks returns a COPY of the break list - mutating
     items in that copy does nothing until it's reassigned back onto the
     colorizer. This was why labels weren't actually rounding up before.

Set RUN_IDW = False to re-apply symbology only on existing layers/rasters.
Run inside ArcGIS Pro (CURRENT project must be open).
"""

import arcpy
import json
import math
import os
import traceback

import numpy as np

# ---------------------------------------------------------------------------
# Inputs and parameters
# ---------------------------------------------------------------------------
IN_POINTS = "As mg/kg"
Z_FIELDS = [
    "As", "Ba", "Ca", "Cr", "Cu", "Fe", "Mn", "Ni",
    "Pb", "Rb", "Sr", "Ti", "V", "Zn",
]
OUT_FOLDER = r"C:\Users\nick\Desktop\arcgis_pro_prjects\ANDOS_AVGOUSTATOS\outputraster"
OUT_CELL_SIZE = 50
POWER = 2
SEARCH_RADIUS = arcpy.sa.RadiusVariable(12, None)
IN_BARRIER = ""
PERCENTILES = [5, 25, 50, 75, 90, 95]
NUM_CLASSES = 7
COLOR_RAMP_NAME = "Red-Yellow-Blue (7 Classes)"

# True = run IDW + symbology. False = fix symbology on existing rasters/layers only.
RUN_IDW = False

# ColorBrewer RdYlBu 7-class, reversed so high values render red
RDYLBU_7_HEX = ["#d73027", "#fc8d59", "#fee090", "#ffffbf", "#e0f3f8", "#91bfdb", "#4575b4"]
CLASS_COLORS_LOW_TO_HIGH = list(reversed(RDYLBU_7_HEX))


def round_half_up(value):
    """Normal rounding (32.1 -> 32, 32.5 -> 33, 32.9 -> 33).

    Python's built-in round() uses banker's rounding (round-half-to-even),
    which would turn 32.5 into 32, not 33. This uses floor(x + 0.5) instead,
    which matches everyday "round half up" rounding for these values.
    """
    return math.floor(value + 0.5)


def hex_to_rgb(hex_color):
    value = hex_color.lstrip("#")
    return [int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16), 100]


def make_cim_color(hex_color):
    r, g, b, a = hex_to_rgb(hex_color)
    color = arcpy.cim.CreateCIMObjectFromClassName("CIMRGBColor", "V2")
    color.values = [r, g, b, a]
    color.colorSpace = arcpy.cim.CreateCIMObjectFromClassName("CIMICCColorSpace", "V2")
    color.colorSpace.url = "Default RGB profile"
    return color


def raster_path_for_field(field):
    return os.path.join(OUT_FOLDER, f"IDW_{field}.tif")


def breaks_json_path():
    return os.path.join(OUT_FOLDER, "idw_breaks.json")


def get_percentile_breaks_from_points(points_fc, field, pct_list):
    """Build 8 break points (7 classes) from sample points.

    All values (min, percentiles, max) are kept exact/unrounded floats.
    Rounding is applied ONLY at label-display time, not here.
    """
    vals = []
    with arcpy.da.SearchCursor(points_fc, [field]) as cursor:
        for row in cursor:
            if row[0] is not None:
                vals.append(row[0])

    if not vals:
        raise ValueError(f"No valid values found for field '{field}' in {points_fc}.")

    arr = np.array(vals, dtype=float)

    # 1. Minimum: exact value, no rounding
    breaks = [float(np.min(arr))]

    # 2. Percentiles: exact values, no rounding
    for p in pct_list:
        v = float(np.percentile(arr, p))
        breaks.append(v)

    # 3. Maximum: exact value, no rounding
    breaks.append(float(np.max(arr)))

    # Ensure classes are strictly increasing
    for i in range(1, len(breaks)):
        if breaks[i] <= breaks[i - 1]:
            breaks[i] = breaks[i - 1] + 1e-6

    return breaks


def load_or_compute_breaks(field):
    breaks_file = breaks_json_path()
    if os.path.exists(breaks_file):
        with open(breaks_file, "r", encoding="utf-8") as handle:
            all_breaks = json.load(handle)
        if field in all_breaks:
            return all_breaks[field]

    return get_percentile_breaks_from_points(IN_POINTS, field, PERCENTILES)


def save_breaks(all_breaks):
    with open(breaks_json_path(), "w", encoding="utf-8") as handle:
        json.dump(all_breaks, handle, indent=2)


def update_classify_colorizer_cim(colorizer, breaks, hex_colors):
    """Mutate an existing CIMRasterClassifyColorizer to lock in the manual
    (custom interval) breaks without breaking the UI dropdowns in ArcGIS Pro.

    Break VALUES (used for classification) are kept exact/unrounded, exactly
    as computed in get_percentile_breaks_from_points.

    Break LABELS (display text only) always show the normally-rounded
    integer, for every class boundary including the first (min) and the max.

    NOTE: CIM uses 'Manual' for classificationMethod (not 'ManualInterval')
    """
    upper_values = breaks[1:]
    if len(upper_values) != len(hex_colors):
        raise RuntimeError(
            f"Break count ({len(upper_values)}) does not match color count ({len(hex_colors)})."
        )

    class_breaks = []
    lower_value = float(breaks[0])
    lower_label = round_half_up(lower_value)

    for i, upper in enumerate(upper_values):
        class_break = arcpy.cim.CreateCIMObjectFromClassName(
            "CIMRasterClassBreak", "V2"
        )

        upper_value = float(upper)
        upper_label = round_half_up(upper_value)

        # Actual classification value: exact/unrounded.
        class_break.upperBound = upper_value

        # Display label: always normally-rounded integers.
        class_break.label = f"{int(lower_label)} - {int(upper_label)}"

        class_break.color = make_cim_color(hex_colors[i])
        class_breaks.append(class_break)

        lower_value = upper_value
        lower_label = upper_label

    # CRITICAL: Set classBreakType to "ClassBreaks" (not "StandardDeviation")
    colorizer.classBreakType = "ClassBreaks"

    # CRITICAL: CIM uses "Manual" (arcpy.mp uses "ManualInterval" - they're different!)
    colorizer.classificationMethod = "Manual"

    colorizer.field = "VALUE"
    colorizer.resamplingType = "BilinearInterpolation"

    colorizer.minimumBreak = float(breaks[0])
    colorizer.showInAscendingOrder = True
    colorizer.classBreaks = class_breaks
    colorizer.numberOfBreaks = len(class_breaks)

    # Clear deviationInterval if it exists (only relevant for StandardDeviation)
    if hasattr(colorizer, 'deviationInterval'):
        try:
            colorizer.deviationInterval = None
        except Exception:
            pass

    # REMOVED numberFormat - it was interfering with explicit label strings.
    # Since every class_break.label is set explicitly above, we do NOT need
    # a colorizer-level numberFormat.  Leaving it out lets Pro use the raw
    # label string we provided (e.g. "5 - 10") without re-formatting.
    if hasattr(colorizer, 'numberFormat'):
        try:
            colorizer.numberFormat = None
        except Exception:
            pass


def get_class_break_count(colorizer):
    breaks = getattr(colorizer, "classBreaks", None)
    if breaks is not None:
        return len(breaks)
    breaks = getattr(colorizer, "colorClassBreaks", None)
    if breaks is not None:
        return len(breaks)
    return 0


def is_classified(layer):
    """Check if layer has proper Manual classification (not Standard Deviation)."""
    cim = layer.getDefinition("V2")
    colorizer = cim.colorizer
    if colorizer is None:
        return False
    if type(colorizer).__name__ != "CIMRasterClassifyColorizer":
        return False
    # CIM uses "Manual" for classificationMethod
    if getattr(colorizer, "classificationMethod", None) != "Manual":
        return False
    if getattr(colorizer, "classBreakType", None) != "ClassBreaks":
        return False
    return get_class_break_count(colorizer) == NUM_CLASSES


def find_map_layer(active_map, layer_name):
    for layer in active_map.listLayers():
        if layer.name == layer_name and layer.isRasterLayer:
            return layer
    return None


def ensure_layer_on_map(active_map, field, raster_path):
    layer_name = f"IDW_{field}"
    layer = find_map_layer(active_map, layer_name)
    if layer:
        return layer

    layer = active_map.addDataFromPath(raster_path)
    if isinstance(layer, list):
        layer = layer[0]
    if not layer:
        raise RuntimeError(f"Could not add {raster_path} to the map.")

    layer.name = layer_name
    layer.visible = False
    return layer


def apply_classified_symbology(layer, breaks):
    """Apply classify symbology with correct "Manual Interval" showing in UI
    and normally-rounded integer labels.

    KEY INSIGHT: arcpy.mp and CIM use DIFFERENT values for the same concept:
    - arcpy.mp uses 'ManualInterval'
    - CIM uses 'Manual'

    KEY INSIGHT #2: When you assign layer.symbology = sym, Pro REGENERATES
    labels from the float break values unless you explicitly set each break's
    .label property via arcpy.mp BEFORE the final assignment.

    KEY INSIGHT #3: sym.colorizer.classBreaks returns a COPY of the break
    list, not a live reference. Mutating .label / .upperBound on items in
    that copy does nothing on its own - the copy must be explicitly
    reassigned back onto sym.colorizer.classBreaks before the next
    layer.symbology = sym, or the edits are silently lost.

    Step 1: Set arcpy.mp with 'ManualInterval' + colorRamp + breakCount
    Step 2: Re-read sym, override each break's upperBound AND label with
            exact values / normally-rounded integer strings, then write the edited
            list back onto sym.colorizer.classBreaks
    Step 3: Final layer.symbology = sym (labels now survive because they
            were written back onto the colorizer before this assignment)
    Step 4: CIM pass to lock in classBreakType and other internals
    """

    aprx = arcpy.mp.ArcGISProject("CURRENT")

    # =========================================================================
    # STEP 1: Initialize colorizer with method + ramp + break count
    # =========================================================================
    sym = layer.symbology
    if hasattr(sym, 'colorizer'):
        if sym.colorizer.type != 'RasterClassifyColorizer':
            sym.updateColorizer('RasterClassifyColorizer')

        sym.colorizer.breakCount = NUM_CLASSES

        # Set colorRamp BEFORE classificationMethod
        ramps = aprx.listColorRamps(COLOR_RAMP_NAME)
        if ramps:
            sym.colorizer.colorRamp = ramps[0]

        # CRITICAL: arcpy.mp uses 'ManualInterval', CIM uses 'Manual'
        sym.colorizer.classificationMethod = 'ManualInterval'

        # First assignment: generates the 7 class break slots
        layer.symbology = sym

    # =========================================================================
    # STEP 2: Best-effort override of break VALUES/LABELS via arcpy.mp.
    #
    # NOTE: On some ArcGIS Pro / arcpy versions, sym.colorizer.classBreaks is
    # READ-ONLY on RasterClassifyColorizer - reassigning it raises
    # "attribute 'breaks' is not supported on this instance". That exception
    # used to propagate out of this function and ABORT before Step 3 (the CIM
    # pass) ever ran - which is why colors/labels looked wrong (they were
    # still Pro's untouched defaults from Step 1).
    #
    # Step 3 (CIM, below) is the real authoritative step for both colors and
    # labels and runs last, so this block is now just best-effort and must
    # NEVER be allowed to block Step 3.
    # =========================================================================
    try:
        sym = layer.symbology
        if hasattr(sym, 'colorizer') and sym.colorizer.type == 'RasterClassifyColorizer':
            mp_breaks = sym.colorizer.classBreaks
            if mp_breaks and len(mp_breaks) == NUM_CLASSES:
                lower_label = round_half_up(float(breaks[0]))
                for i, mb in enumerate(mp_breaks):
                    upper_value = float(breaks[i + 1])
                    upper_label = round_half_up(upper_value)
                    mb.upperBound = upper_value
                    mb.label = f"{int(lower_label)} - {int(upper_label)}"
                    lower_label = upper_label

            layer.symbology = sym
    except Exception:
        # Non-fatal: Step 3 (CIM) below sets the real, final values/labels.
        pass

    # =========================================================================
    # STEP 3: CIM final pass - lock internals that arcpy.mp can't touch
    # =========================================================================
    cim_layer = layer.getDefinition("V2")

    if cim_layer.colorizer is None:
        cim_layer.colorizer = arcpy.cim.CreateCIMObjectFromClassName(
            "CIMRasterClassifyColorizer", "V2"
        )

    update_classify_colorizer_cim(cim_layer.colorizer, breaks, CLASS_COLORS_LOW_TO_HIGH)

    cim_layer.expanded = False

    layer.setDefinition(cim_layer)


def apply_symbology_for_field(active_map, field, breaks):
    raster_path = raster_path_for_field(field)
    layer_name = f"IDW_{field}"

    if not os.path.exists(raster_path):
        raise FileNotFoundError(f"Missing raster: {raster_path}")

    try:
        arcpy.management.CalculateStatistics(raster_path)
    except Exception:
        pass

    layer = ensure_layer_on_map(active_map, field, raster_path)
    apply_classified_symbology(layer, breaks)

    if not is_classified(layer):
        # Second attempt with fresh CIM read
        apply_classified_symbology(layer, breaks)

    return layer, is_classified(layer)


def run_idw_for_field(field):
    print(f"Running IDW for {field}...")
    breaks = get_percentile_breaks_from_points(IN_POINTS, field, PERCENTILES)
    print(f"  Breaks: {breaks}")

    out_idw = arcpy.sa.Idw(
        in_point_features=IN_POINTS,
        z_field=field,
        cell_size=OUT_CELL_SIZE,
        power=POWER,
        search_radius=SEARCH_RADIUS,
        in_barrier_polyline_features=IN_BARRIER,
    )

    out_path = raster_path_for_field(field)
    out_idw.save(out_path)
    print(f"  Saved: {os.path.basename(out_path)}")

    try:
        arcpy.management.CalculateStatistics(out_path)
    except Exception as exc:
        print(f"  WARNING: CalculateStatistics failed: {exc}")

    return breaks


def apply_symbology_pass(active_map, breaks_by_field):
    print("\nApplying classified symbology to all layers...")
    failed = []

    for field in Z_FIELDS:
        layer_name = f"IDW_{field}"
        try:
            breaks = breaks_by_field[field]
            layer, ok = apply_symbology_for_field(active_map, field, breaks)
            status = "OK" if ok else "STILL STRETCH/STDDEV"
            print(f"  {layer_name}: {status}")
            if not ok:
                failed.append(field)
        except Exception as exc:
            print(f"  {layer_name}: ERROR - {exc}")
            traceback.print_exc()
            failed.append(field)

    return failed


def fix_reverted_layers(active_map, breaks_by_field):
    """Second pass: ArcGIS sometimes reverts earlier layers to stretch while batch runs."""
    print("\nFix pass for layers that reverted to stretch/stddev...")
    fixed_any = False
    failed = []

    aprx = arcpy.mp.ArcGISProject("CURRENT")
    if aprx.activeView:
        try:
            aprx.activeView.refresh()
        except AttributeError:
            pass

    for field in Z_FIELDS:
        layer_name = f"IDW_{field}"
        layer = find_map_layer(active_map, layer_name)
        if not layer:
            continue
        if is_classified(layer):
            continue

        fixed_any = True
        print(f"  Re-applying classify to {layer_name}...")
        try:
            _, ok = apply_symbology_for_field(active_map, field, breaks_by_field[field])
            if not ok:
                failed.append(field)
        except Exception as exc:
            print(f"  {layer_name}: ERROR - {exc}")
            failed.append(field)

    if not fixed_any:
        print("  All layers already classified.")
    return failed


def main():
    os.makedirs(OUT_FOLDER, exist_ok=True)

    aprx = arcpy.mp.ArcGISProject("CURRENT")
    active_map = aprx.activeMap
    if not active_map:
        raise RuntimeError("No active map found in the CURRENT project.")

    env_kwargs = {
        "overwriteOutput": True,
        "addOutputsToMap": False,
        "extent": "andros_gys",
        "cellSize": None,
        "cellSizeProjectionMethod": "CONVERT_UNITS",
        "mask": "andros_municipality_community",
        "snapRaster": None,
        "tileSize": "128 128",
        "compression": "LZW",
        "outputCoordinateSystem": active_map.spatialReference,
    }

    arcpy.CheckOutExtension("Spatial")
    failed_fields = []

    try:
        breaks_by_field = {}

        with arcpy.EnvManager(**env_kwargs):
            if RUN_IDW:
                print("Phase 1: IDW interpolation...")
                for field in Z_FIELDS:
                    try:
                        breaks_by_field[field] = run_idw_for_field(field)
                    except Exception as exc:
                        print(f"  ERROR in IDW for {field}: {exc}")
                        traceback.print_exc()
                        failed_fields.append(field)
                save_breaks(breaks_by_field)
            else:
                print("Phase 1 skipped (RUN_IDW = False).")
                for field in Z_FIELDS:
                    breaks_by_field[field] = load_or_compute_breaks(field)

            failed_symbology = apply_symbology_pass(active_map, breaks_by_field)
            failed_fix = fix_reverted_layers(active_map, breaks_by_field)

            if aprx.activeView:
                try:
                    aprx.activeView.refresh()
                except AttributeError:
                    pass
            try:
                aprx.save()
            except Exception:
                pass

        failed_fields = sorted(set(failed_fields + failed_symbology + failed_fix))
        if failed_fields:
            print(f"\nFields needing attention: {failed_fields}")
        else:
            print("\nAll fields classified successfully.")
        print("Done.")
    finally:
        arcpy.CheckInExtension("Spatial")


if __name__ == "__main__":
    main()
