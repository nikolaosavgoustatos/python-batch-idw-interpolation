"""
Batch IDW interpolation with log-scaled classified symbology.

Classification:
    N_CLASSES breaks evenly spaced in log10 space, upperBounds back-transformed
    (10**x) so the raster classification follows the log distribution while the
    legend labels stay in true ppm.
Color Ramp:
    "Prediction" (pulled from ArcGIS Colors style by name). Colors are sampled
    directly from the ramp via readColors() — NOT read back from the layer's
    symbology (which was returning black on re-runs).
Labels:
    Contiguous, non-overlapping ranges rounded UP to 1 decimal place.
    Formatted as "min - X.0", "X.1 - Y.0", "Y.1 - max.0" (always keeping 1 
    decimal place, so 4 becomes 4.0, 4.55 becomes 4.6).
Legend:
    Descending order (highest concentrations at top).
Layer Blend:
    Multiply (applied via CIM to guarantee it sticks).

Set RUN_IDW = False to re-apply symbology only on existing layers/rasters.
Set EXPORT_LOG_MAPS = True to also export per-element TIFFs.
Run inside ArcGIS Pro (CURRENT project must be open).
"""

import arcpy
import math
import os
import traceback

import numpy as np

# ---------------------------------------------------------------------------
# Inputs and parameters
# ---------------------------------------------------------------------------
IN_POINTS = "As mg/kg"
Z_FIELDS = [
    "As", "Ba", "Ca", "Cr", "Cu", "Fe", "Mn", "Ni",
    "Pb", "Rb", "Sr", "Ti", "V", "Zn",
]
OUT_FOLDER = r"C:\Users\nick\Desktop\arcgis_pro_prjects\ANDOS_AVGOUSTATOS\outputraster"
OUT_CELL_SIZE = 50
POWER = 2
SEARCH_RADIUS = arcpy.sa.RadiusVariable(12, None)
IN_BARRIER = ""

NUM_CLASSES = 7
COLOR_RAMP_NAME = "Prediction"       # exact name in ArcGIS Colors style
LOG_MIN_FLOOR = 1e-6                 # avoid log10(0) for near-zero minimums

# Fallback ramp (blue -> red) used ONLY if the named ramp truly can't be
# sampled for a given break. Distinct colors beat identical flat-red classes.
FALLBACK_RAMP = [(49, 54, 149), (116, 173, 209), (255, 255, 191),
                  (253, 174, 97), (215, 48, 39)]

# True = run IDW + symbology. False = fix symbology on existing rasters/layers only.
RUN_IDW = False

# True = export one TIFF per element with the log-scaled symbology.
EXPORT_LOG_MAPS = False
EXPORT_DPI = 300
EXPORT_WIDTH = 2400
EXPORT_HEIGHT = 2400
EXPORT_SUBFOLDER = "log_maps"

# Cache the color ramp object once - avoid re-fetching it from project styles
# on every field (also avoids the repeated listColorRamps() cost).
_PREDICTION_RAMP_CACHE = None


# ---------------------------------------------------------------------------
# Rounding / formatting helpers
# ---------------------------------------------------------------------------
def ceil_to_decimal(value, decimals=1):
    """Round UP (toward +inf) to a fixed number of decimal places.
    
    Includes a tolerance so that a value like 4.0001 absorbs the floating 
    point noise and correctly becomes 4.0 instead of jumping to 4.1.
    """
    factor = 10 ** decimals
    scaled = value * factor
    
    # If scaled is within 1e-3 above an integer, treat it as that integer
    # to absorb floating point dust (e.g. 4.0001 -> 40.001 -> 40.0)
    if scaled - math.floor(scaled) <= 1e-3:
        return math.floor(scaled) / factor
    
    return math.ceil(scaled) / factor


def format_decimal(value):
    """Format with EXACTLY 1 decimal place (e.g. 4 -> 4.0, 4.55 -> 4.6)."""
    # Using Python's standard formatting safely rounds and keeps the .0
    return f"{value:.1f}"


def build_class_labels(breaks):
    """Build contiguous, non-overlapping labels with 1 decimal ceil rounding.
    Formatted as "min - X.0", "X.1 - Y.0", "Y.1 - max.0".
    """
    labels = []
    for i in range(len(breaks) - 1):
        if i == 0:
            lower = ceil_to_decimal(float(breaks[0]))
        else:
            # Calculate previous upper bound, add 0.1 for the next lower bound
            prev_upper = ceil_to_decimal(float(breaks[i]))
            lower = prev_upper + 0.1
        upper = ceil_to_decimal(float(breaks[i + 1]))
        labels.append(f"{format_decimal(lower)} - {format_decimal(upper)}")
    return labels


# ---------------------------------------------------------------------------
# Color helpers
# ---------------------------------------------------------------------------
def rgb_to_cim_color(r, g, b, a=100):
    cim_color = arcpy.cim.CreateCIMObjectFromClassName("CIMRGBColor", "V2")
    cim_color.values = [int(r), int(g), int(b), int(a)]
    cim_color.colorSpace = arcpy.cim.CreateCIMObjectFromClassName("CIMICCColorSpace", "V2")
    cim_color.colorSpace.url = "Default RGB profile"
    return cim_color


def arcpy_color_to_cim(arcpy_color):
    """Convert an arcpy.mp.Color (or similar RGB-bearing object) to CIMRGBColor."""
    if hasattr(arcpy_color, "RGB"):
        r, g, b = arcpy_color.RGB[:3]
    else:
        r = int(getattr(arcpy_color, "red", 0))
        g = int(getattr(arcpy_color, "green", 0))
        b = int(getattr(arcpy_color, "blue", 0))
    a = int(getattr(arcpy_color, "alpha", 100))
    return rgb_to_cim_color(r, g, b, a)


def fallback_color_for_index(i, n):
    """Deterministic, visually distinct fallback color - never flat red for
    every class. Linearly interpolates across FALLBACK_RAMP."""
    if n <= 1:
        t = 0.0
    else:
        t = i / (n - 1)
    stops = FALLBACK_RAMP
    scaled = t * (len(stops) - 1)
    lo = int(math.floor(scaled))
    hi = min(lo + 1, len(stops) - 1)
    frac = scaled - lo
    r = stops[lo][0] + (stops[hi][0] - stops[lo][0]) * frac
    g = stops[lo][1] + (stops[hi][1] - stops[lo][1]) * frac
    b = stops[lo][2] + (stops[hi][2] - stops[lo][2]) * frac
    return rgb_to_cim_color(r, g, b, 100)


def get_prediction_ramp(force_refresh=False):
    """Pull the 'Prediction' color ramp from project styles (cached)."""
    global _PREDICTION_RAMP_CACHE
    if _PREDICTION_RAMP_CACHE is not None and not force_refresh:
        return _PREDICTION_RAMP_CACHE

    aprx = arcpy.mp.ArcGISProject("CURRENT")
    ramps = aprx.listColorRamps(COLOR_RAMP_NAME)
    if not ramps:
        ramps = aprx.listColorRamps(f"*{COLOR_RAMP_NAME}*")
    if not ramps:
        raise RuntimeError(
            f"Color ramp '{COLOR_RAMP_NAME}' was not found in project styles. "
            "Open the Symbology pane / Style manager and verify the ramp name."
        )
    _PREDICTION_RAMP_CACHE = ramps[0]
    return _PREDICTION_RAMP_CACHE


def sample_ramp_colors(ramp, num_classes):
    """Sample N colors directly from a ColorRamp using readColors().

    This is the reliable way to get colors from the named ramp. The previous
    approach of reading colors back from the layer's arcpy.mp symbology was
    unreliable on re-runs (returned black/empty colors).
    """
    try:
        colors = ramp.readColors(num_classes)
        if colors and len(colors) >= num_classes:
            return [arcpy_color_to_cim(c) for c in colors[:num_classes]]
    except Exception as exc:
        print(f"    NOTE: ramp.readColors() failed: {exc}")
    return None


# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------
def raster_path_for_field(field):
    return os.path.join(OUT_FOLDER, f"IDW_{field}.tif")


# ---------------------------------------------------------------------------
# Log breaks from raster min/max
# ---------------------------------------------------------------------------
def get_raster_min_max(raster_path):
    """Return (min, max) of a raster, forcing statistics first."""
    try:
        arcpy.management.CalculateStatistics(raster_path)
    except Exception as exc:
        print(f"    WARNING: CalculateStatistics failed for {raster_path}: {exc}")
    raster = arcpy.Raster(raster_path)
    rmin, rmax = raster.minimum, raster.maximum
    if rmin is None or rmax is None:
        raise RuntimeError(
            f"Raster {raster_path} has no min/max statistics "
            "(CalculateStatistics may have failed, or raster is all-NoData)."
        )
    return float(rmin), float(rmax)


def build_log_breaks_and_labels(raw_min, raw_max, num_classes, floor_min=LOG_MIN_FLOOR):
    """Build N+1 break points evenly spaced in log10 space, plus N labels."""
    if raw_min <= 0:
        raw_min = floor_min
    if raw_max <= raw_min:
        raw_max = raw_min * 10.0

    log_min = math.log10(raw_min)
    log_max = math.log10(raw_max)
    log_breaks = np.linspace(log_min, log_max, num_classes + 1)
    breaks = [float(10 ** x) for x in log_breaks]

    labels = build_class_labels(breaks)

    return breaks, labels


# ---------------------------------------------------------------------------
# Symbology Application
# ---------------------------------------------------------------------------
def update_colorizer_cim(colorizer, breaks, labels, cim_colors):
    """Configure a CIMRasterClassifyColorizer for log-spaced breaks.

    This function is designed to work on a FRESH colorizer object (created
    via CreateCIMObjectFromClassName), NOT on a pre-existing one. This avoids
    stale properties (numberFormat, deviationInterval, etc.) from previous
    runs that were overriding our custom labels and colors.
    """
    upper_values = breaks[1:]
    n = len(upper_values)

    class_breaks = []
    for i in range(n):
        cb = arcpy.cim.CreateCIMObjectFromClassName("CIMRasterClassBreak", "V2")
        cb.upperBound = float(upper_values[i])
        cb.label = labels[i]
        cb.color = cim_colors[i]
        class_breaks.append(cb)

    colorizer.classBreakType = "ClassBreaks"
    # CIM uses "Manual" (arcpy.mp uses "ManualInterval" - they're different!)
    colorizer.classificationMethod = "Manual"
    colorizer.field = "Value"
    colorizer.resamplingType = "BilinearInterpolation"
    colorizer.minimumBreak = float(breaks[0])

    # REVERSED ORDER IN LEGEND: highest values appear at the top
    colorizer.showInAscendingOrder = False

    colorizer.classBreaks = class_breaks
    colorizer.numberOfBreaks = len(class_breaks)

    # NOTE: Do NOT set numberFormat or deviationInterval to None here.
    # On a fresh colorizer they don't exist yet, and setting them to None
    # on a pre-existing colorizer was causing Pro to auto-regenerate labels
    # from the upper bounds, discarding our custom labels.


def get_class_break_count(colorizer):
    breaks = getattr(colorizer, "classBreaks", None)
    if breaks is not None:
        return len(breaks)
    breaks = getattr(colorizer, "colorClassBreaks", None)
    if breaks is not None:
        return len(breaks)
    return 0


def is_classified(layer):
    """Check if layer has proper classification."""
    cim = layer.getDefinition("V2")
    colorizer = cim.colorizer
    if colorizer is None:
        return False
    if type(colorizer).__name__ != "CIMRasterClassifyColorizer":
        return False
    if getattr(colorizer, "classBreakType", None) != "ClassBreaks":
        return False
    return get_class_break_count(colorizer) == NUM_CLASSES


def find_map_layer(active_map, layer_name):
    for layer in active_map.listLayers():
        if layer.name == layer_name and layer.isRasterLayer:
            return layer
    return None


def ensure_layer_on_map(active_map, field, raster_path):
    layer_name = f"IDW_{field}"
    layer = find_map_layer(active_map, layer_name)
    if layer:
        return layer

    layer = active_map.addDataFromPath(raster_path)
    if isinstance(layer, list):
        layer = layer[0]
    if not layer:
        raise RuntimeError(f"Could not add {raster_path} to the map.")

    layer.name = layer_name
    layer.visible = False
    return layer


def apply_symbology(layer, raster_path, num_classes=NUM_CLASSES, floor_min=LOG_MIN_FLOOR):
    """Apply log-scaled classified symbology to a raster layer."""
    raw_min, raw_max = get_raster_min_max(raster_path)
    breaks, labels = build_log_breaks_and_labels(
        raw_min, raw_max, num_classes, floor_min
    )

    ramp = get_prediction_ramp()

    # Step 1: Ensure the layer has a RasterClassifyColorizer with the ramp set.
    # This is a minimal setup — the CIM pass (Step 3) does the heavy lifting.
    sym = layer.symbology
    if hasattr(sym, "colorizer"):
        if sym.colorizer.type != "RasterClassifyColorizer":
            sym.updateColorizer("RasterClassifyColorizer")
            # CRITICAL: updateColorizer() only mutates this local, uncommitted
            # `sym` object — must commit before re-fetching.
            layer.symbology = sym
            sym = layer.symbology
        try:
            sym.colorizer.field = "Value"
            sym.colorizer.classificationMethod = "ManualInterval"
            sym.colorizer.colorRamp = ramp
            sym.colorizer.breakCount = num_classes
            layer.symbology = sym
        except Exception as exc:
            print(f"    NOTE: mp setup partial failure: {exc}")

    # Step 2: Sample colors DIRECTLY from the Prediction ramp.
    # This is the key fix — readColors() is reliable on every run, unlike
    # reading colors back from the layer's symbology which returned black
    # on re-runs.
    cim_colors = sample_ramp_colors(ramp, num_classes)
    if cim_colors is None:
        print(f"    Using deterministic fallback ramp for {os.path.basename(raster_path)}.")
        cim_colors = [fallback_color_for_index(i, num_classes) for i in range(num_classes)]

    # Step 3: CIM pass — create a FRESH colorizer to avoid stale properties.
    # The previous approach mutated the existing colorizer, which retained
    # a stale numberFormat from the previous run that caused Pro to discard
    # our custom range labels and show bare numbers instead.
    cim_layer = layer.getDefinition("V2")
    new_colorizer = arcpy.cim.CreateCIMObjectFromClassName(
        "CIMRasterClassifyColorizer", "V2"
    )
    update_colorizer_cim(new_colorizer, breaks, labels, cim_colors)
    cim_layer.colorizer = new_colorizer
    cim_layer.expanded = False

    # Layer Blend Mode — DO NOT CHANGE. This is working correctly.
    cim_layer.blendingMode = "Multiply"

    layer.setDefinition(cim_layer)

    return breaks, labels


def apply_symbology_for_field(active_map, field):
    raster_path = raster_path_for_field(field)
    layer_name = f"IDW_{field}"

    if not os.path.exists(raster_path):
        raise FileNotFoundError(f"Missing raster: {raster_path}")

    layer = ensure_layer_on_map(active_map, field, raster_path)

    last_exc = None
    for attempt in (1, 2):
        try:
            apply_symbology(layer, raster_path)
        except Exception as exc:
            last_exc = exc
            print(f"    {layer_name}: attempt {attempt} raised: {exc}")
            traceback.print_exc()
            continue

        if is_classified(layer):
            return layer, True
        print(f"    {layer_name}: attempt {attempt} did not result in a valid "
              f"classification (is_classified() == False).")

    if last_exc is not None:
        print(f"    {layer_name}: last error was: {last_exc}")

    return layer, False


# ---------------------------------------------------------------------------
# Map Export
# ---------------------------------------------------------------------------
def export_element_maps(active_map, output_folder):
    """For each element field: make the layer visible, export the map view
    to TIFF, then hide the layer again.
    """
    print("\n=== Exporting element maps with log-scaled symbology ===")

    # Hide all element layers first
    for field in Z_FIELDS:
        layer = find_map_layer(active_map, f"IDW_{field}")
        if layer:
            layer.visible = False

    export_subfolder = os.path.join(output_folder, EXPORT_SUBFOLDER)
    os.makedirs(export_subfolder, exist_ok=True)

    aprx = arcpy.mp.ArcGISProject("CURRENT")
    active_view = aprx.activeView

    failed = []
    for field in Z_FIELDS:
        layer_name = f"IDW_{field}"
        raster_path = raster_path_for_field(field)
        if not os.path.exists(raster_path):
            print(f"  {layer_name}: raster missing - skipping")
            failed.append(field)
            continue

        layer = find_map_layer(active_map, layer_name)
        if not layer:
            try:
                layer = ensure_layer_on_map(active_map, field, raster_path)
            except Exception as exc:
                print(f"  {layer_name}: couldn't add layer - {exc}")
                failed.append(field)
                continue

        try:
            layer.visible = True

            # Ensure symbology is locked (in case map reverted it)
            apply_symbology(layer, raster_path)

            if active_view:
                try:
                    active_view.refresh()
                except Exception:
                    pass

            out_tiff = os.path.join(export_subfolder, f"{layer_name}_log.tif")
            if active_view and active_view.type == "MAP_VIEW":
                active_view.exportToTIFF(
                    out_tiff,
                    resolution=EXPORT_DPI,
                    width=EXPORT_WIDTH,
                    height=EXPORT_HEIGHT,
                )
                print(f"  Exported: {os.path.basename(out_tiff)}")
            else:
                print(f"  {layer_name}: no active MAP_VIEW - skipping export")
                failed.append(field)

            layer.visible = False
        except Exception as exc:
            print(f"  {layer_name}: ERROR - {exc}")
            traceback.print_exc()
            failed.append(field)
            try:
                layer.visible = False
            except Exception:
                pass

    return failed


# ---------------------------------------------------------------------------
# IDW
# ---------------------------------------------------------------------------
def run_idw_for_field(field):
    print(f"Running IDW for {field}...")

    out_idw = arcpy.sa.Idw(
        in_point_features=IN_POINTS,
        z_field=field,
        cell_size=OUT_CELL_SIZE,
        power=POWER,
        search_radius=SEARCH_RADIUS,
        in_barrier_polyline_features=IN_BARRIER,
    )

    out_path = raster_path_for_field(field)
    out_idw.save(out_path)
    print(f"  Saved: {os.path.basename(out_path)}")

    try:
        arcpy.management.CalculateStatistics(out_path)
    except Exception as exc:
        print(f"  WARNING: CalculateStatistics failed: {exc}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    os.makedirs(OUT_FOLDER, exist_ok=True)

    aprx = arcpy.mp.ArcGISProject("CURRENT")
    active_map = aprx.activeMap
    if not active_map:
        raise RuntimeError("No active map found in the CURRENT project.")

    # Fail fast (with a clear message) if the ramp genuinely doesn't exist
    try:
        get_prediction_ramp()
    except RuntimeError as exc:
        print(f"FATAL: {exc}")
        return

    env_kwargs = {
        "overwriteOutput": True,
        "addOutputsToMap": False,
        "extent": "andros_gys",
        "cellSize": None,
        "cellSizeProjectionMethod": "CONVERT_UNITS",
        "mask": "andros_municipality_community",
        "snapRaster": None,
        "tileSize": "128 128",
        "compression": "LZW",
        "outputCoordinateSystem": active_map.spatialReference,
    }

    arcpy.CheckOutExtension("Spatial")
    failed_fields = []

    try:
        with arcpy.EnvManager(**env_kwargs):
            if RUN_IDW:
                print("Phase 1: IDW interpolation...")
                for field in Z_FIELDS:
                    try:
                        run_idw_for_field(field)
                    except Exception as exc:
                        print(f"  ERROR in IDW for {field}: {exc}")
                        traceback.print_exc()
                        failed_fields.append(field)
            else:
                print("Phase 1 skipped (RUN_IDW = False).")

            # Phase 2: Log-scaled symbology on map layers
            print("\nPhase 2: Applying log-scaled (Prediction) symbology to all layers...")
            for field in Z_FIELDS:
                layer_name = f"IDW_{field}"
                try:
                    layer, ok = apply_symbology_for_field(active_map, field)
                    status = "OK" if ok else "FAILED"
                    print(f"  {layer_name}: {status}")
                    if not ok:
                        failed_fields.append(field)
                except Exception as exc:
                    print(f"  {layer_name}: ERROR - {exc}")
                    traceback.print_exc()
                    failed_fields.append(field)

            # Phase 3 (optional): per-element TIFF exports
            if EXPORT_LOG_MAPS:
                try:
                    failed_export = export_element_maps(active_map, OUT_FOLDER)
                    failed_fields.extend(failed_export)
                except Exception as exc:
                    print(f"  ERROR during map export: {exc}")
                    traceback.print_exc()

            if aprx.activeView:
                try:
                    aprx.activeView.refresh()
                except AttributeError:
                    pass
            try:
                aprx.save()
            except Exception:
                pass

        failed_fields = sorted(set(failed_fields))
        if failed_fields:
            print(f"\nFields needing attention: {failed_fields}")
        else:
            print("\nAll fields processed successfully.")
        print("Done.")
    finally:
        arcpy.CheckInExtension("Spatial")


if __name__ == "__main__":
    main()
